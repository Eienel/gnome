# ============================================================================
# Tab402 — EVM-native x402 payment rail, settled on Robinhood Chain.
# Copy to `.env` and fill the SECRETS. One key can act as facilitator +
# treasury + demo wallet for a self-contained deployment.
# ============================================================================

# ---- Network (Robinhood Chain) ---------------------------------------------
# CAIP-2 network id the rail charges on. Robinhood Chain is an EVM L2 (Arbitrum
# Orbit stack); set ROBINHOOD_CHAIN_ID + RPCURL_ROBINHOOD for mainnet access.
CAIP2_CHAIN_ID=eip155:42161
ROBINHOOD_CHAIN_ID=42161
RPCURL_ROBINHOOD=https://arb1.arbitrum.io/rpc
ROBINHOOD_EXPLORER=https://arbiscan.io
# Networks the facilitator will settle on (comma-separated CAIP-2 ids).
NETWORKS=eip155:42161

# ---- Settlement mode -------------------------------------------------------
# onchain  = submit real EIP-3009 transferWithAuthorization txs (needs a funded
#            facilitator key + a token that supports EIP-3009).
# simulate = full x402 round-trip with a deterministic pseudo tx hash (great for
#            demos before mainnet access / token funding is provisioned).
SETTLEMENT_MODE=simulate

# ---- Facilitator (verifies + settles; pays gas) ----------------------------
PORT=4022
# SECRET: 0x-prefixed EVM private key. Fund with native gas for on-chain mode.
FACILITATOR_PRIVATE_KEY=

# ---- Proxy / rail ----------------------------------------------------------
PROXY_PORT=4021
FACILITATOR_URL=http://localhost:4022
# Address that receives payments (the operator / treasury).
PAYEE_ADDRESS=0x0000000000000000000000000000000000000000
# Payment token (ERC-20 with EIP-3009 transferWithAuthorization, e.g. USDC).
# In onchain mode, name/symbol/decimals/version are read from the contract.
ASSET_ADDRESS=0x0000000000000000000000000000000000000000
ASSET_NAME=USD Coin
ASSET_SYMBOL=USDC
ASSET_DECIMALS=6
ASSET_VERSION=2
# Price per call: "$0.001" (dollar-denominated) or a raw base-unit integer.
PRICE=$0.001
# SECRET: Deepgram API key (upstream API behind the paywall).
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Optional cap for the house-funded demo.
DEMO_MAX_CHARS=300

# ---- Treasury / demo wallet ------------------------------------------------
# SECRET: key that holds the token supply. Powers the "Fund from treasury"
# button and the no-wallet demo. Can equal FACILITATOR_PRIVATE_KEY.
TREASURY_PRIVATE_KEY=
# Optional dedicated demo wallet (defaults to TREASURY_PRIVATE_KEY).
DEMO_AGENT_PRIVATE_KEY=

# ---- Reference agent (holds tokens; balance = hard cap) --------------------
SERVER_URL=http://localhost:4021
# SECRET: 0x-prefixed EVM private key for the agent.
CLIENT_PRIVATE_KEY=
TEXT=Hello. I am an autonomous agent, and I just paid for this sentence on Robinhood Chain.

# ---- Persistence -----------------------------------------------------------
LEDGER_PATH=data/ledger.jsonl
