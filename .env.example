# ============================================================================
# Gnome — EVM-native x402 payment rail.
# Copy to `.env` and fill the SECRETS. One key can act as facilitator +
# treasury + demo wallet for a self-contained deployment.
#
# Default config below = REAL testnet settlement on Base Sepolia (Circle USDC).
# Flip to Robinhood Chain mainnet at go-live (see the "GO LIVE" block).
# ============================================================================

# ---- Network: Base Sepolia testnet (default) -------------------------------
# Real on-chain settlement against Circle's testnet USDC (EIP-3009 capable).
CAIP2_CHAIN_ID=eip155:84532
NETWORKS=eip155:84532
RPCURL_BASE_SEPOLIA=https://sepolia.base.org

# ---- Settlement mode -------------------------------------------------------
# onchain  = submit real EIP-3009 transferWithAuthorization txs. Needs a funded
#            facilitator key (Base Sepolia ETH for gas) + agent USDC balance.
# simulate = full x402 round-trip with a deterministic pseudo tx hash (no chain).
SETTLEMENT_MODE=onchain

# ---- Facilitator (verifies + settles; pays gas) ----------------------------
# Internal-only port (the public port is PROXY_PORT / the host's $PORT).
FACILITATOR_PORT=4022
# SECRET: 0x-prefixed EVM key. Fund with Base Sepolia ETH for gas.
#   Faucet: https://portal.cdp.coinbase.com/products/faucet
FACILITATOR_PRIVATE_KEY=

# ---- Proxy / rail ----------------------------------------------------------
# Public port. Hosts like Render/Heroku inject PORT and it wins over PROXY_PORT.
PROXY_PORT=4021
FACILITATOR_URL=http://localhost:4022
# Address that receives payments (the operator / treasury).
PAYEE_ADDRESS=0x0000000000000000000000000000000000000000
# Payment token — Base Sepolia USDC. In onchain mode, name/symbol/decimals/
# version are read from the contract at boot.
ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ASSET_NAME=USDC
ASSET_SYMBOL=USDC
ASSET_DECIMALS=6
ASSET_VERSION=2
# Price per call: "$0.001" (dollar-denominated) or a raw base-unit integer.
PRICE=$0.001
# SECRET: Deepgram API key (upstream API behind the paywall).
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEMO_MAX_CHARS=300

# ---- Treasury / demo wallet ------------------------------------------------
# SECRET: key holding the token supply. Powers "Fund from treasury" and the
# no-wallet demo. Needs a USDC balance to pay demo invoices. Can equal the
# facilitator key. Base Sepolia USDC faucet: https://faucet.circle.com
TREASURY_PRIVATE_KEY=
# Optional dedicated demo wallet (defaults to TREASURY_PRIVATE_KEY).
DEMO_AGENT_PRIVATE_KEY=

# ---- Reference agent (holds USDC; balance = hard cap) ----------------------
SERVER_URL=http://localhost:4021
# SECRET: 0x-prefixed EVM key for the agent (needs a USDC balance).
CLIENT_PRIVATE_KEY=
TEXT=Hello. I am an autonomous agent, and I just paid for this sentence on-chain.

# ---- Persistence -----------------------------------------------------------
LEDGER_PATH=data/ledger.jsonl

# ============================================================================
# GO LIVE — Robinhood Chain mainnet
# When Robinhood mainnet access is provisioned, swap the network block above
# for the values below and point ASSET_ADDRESS at the mainnet payment token.
# Robinhood Chain is an EVM L2 (Arbitrum Orbit stack).
# ============================================================================
# CAIP2_CHAIN_ID=eip155:<ROBINHOOD_CHAIN_ID>
# NETWORKS=eip155:<ROBINHOOD_CHAIN_ID>
# ROBINHOOD_CHAIN_ID=<chain id>
# RPCURL_ROBINHOOD=<mainnet json-rpc>
# ROBINHOOD_EXPLORER=<explorer base url>
# ASSET_ADDRESS=<mainnet stablecoin address>
